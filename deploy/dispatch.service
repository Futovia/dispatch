# systemd USER unit for dispatch. No root needed.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/dispatch.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now dispatch
#   loginctl enable-linger $USER      # keep it running when you log out
#   journalctl --user -u dispatch -f
#
# Runs as you, on purpose: the agent uses YOUR claude and codex logins, YOUR
# ssh keys, YOUR dotfiles. That is the point of texting your own box.

[Unit]
Description=dispatch - text your server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/dev/dispatch
ExecStart=/usr/bin/node %h/dev/dispatch/dist/cli.js start
Restart=always
RestartSec=3
# claude, codex and dispatch itself must be on PATH for the agent's subprocesses.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dispatch

[Install]
WantedBy=default.target
